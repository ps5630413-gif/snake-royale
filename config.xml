<?xml version='1.0' encoding='utf-8'?>
<!--
  Cordova / PhoneGap project descriptor (alternative to Capacitor).
  The web assets live in ./www which is exactly what Cordova expects.
  AdMob plugin entries are commented out - uncomment after you install the
  plugin (see README.md -> "Monetization").
-->
<widget id="com.snakeroyale.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Snake Royale</name>
    <description>A mobile battle-royale snake game built with HTML5, CSS3 and JavaScript.</description>
    <author email="dev@example.com" href="https://example.com">Snake Royale Team</author>

    <!-- Entry point of the web app -->
    <content src="index.html" />

    <!-- Only allow the app to talk to itself (no external network needed) -->
    <access origin="*" />
    <allow-intent href="market:*" />

    <!-- Keep the game alive and responsive on Android -->
    <preference name="SplashScreen" value="screen" />
    <preference name="SplashScreenBackgroundColor" value="#05070f" />
    <preference name="AndroidPersistentFileLocation" value="Internal" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="KeepRunning" value="true" />
    <preference name="LoadUrlTimeoutValue" value="60000" />
    <preference name="AndroidInsecureFileModeEnabled" value="false" />

    <!-- AdMob (uncomment once installed):
         cordova plugin add cordova-plugin-admob-free --save --variable ADMOB_APP_ID=ca-app-pub-xxx~yyy
    <plugin name="cordova-plugin-admob-free" spec="^1.0.0">
        <variable name="ADMOB_APP_ID" value="ca-app-pub-3940256099942544~3347511713" />
    </plugin>
    -->

    <platform name="android">
        <icon density="ldpi" src="res/android/icon-ldpi.png" />
        <icon density="mdpi" src="res/android/icon-mdpi.png" />
        <icon density="hdpi" src="res/android/icon-hdpi.png" />
        <icon density="xhdpi" src="res/android/icon-xhdpi.png" />
        <icon density="xxhdpi" src="res/android/icon-xxhdpi.png" />
        <icon density="xxxhdpi" src="res/android/icon-xxxhdpi.png" />
    </platform>
</widget>
